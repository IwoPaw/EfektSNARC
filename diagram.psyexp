      <Param name="conditions" updates="None" val="[{'uuu': 0, 'eee': 'Ocenianie wielkości liczb\n\nPorównaj liczbę na boku z liczbą na środku. Jeśli liczba boczna jest większa naciśnij strzałkę do góry, jeśli jest mniesza naciśnij strzałkę w dół.'}, {'uuu': 1, 'eee': &quot;'Ocenianie kolejności w alfabecie\n\nPorównaj miejsce litery na boku z literą na środku. Jeśli litera na boku jest bliżej początku alfabetu nacisnij strzałkę w dół, jeśli jesbliżej końca naciśnij strzałkę w górę.&quot;}, {'uuu': 2, 'eee': 'Ocenianie wielkości wielkości figur\n\nPorównaj figurę na boku z figurą na środku. Jeśli figura boczna jest większa naciśnij strzałkę do góry, jeśli jest mniejsza naciśnij strzałkę w dół.'}, {'uuu': 3, 'eee': 'Znowu liczby :) '}, {'uuu': 4, 'eee': 'Znowu litery :)'}]" valType="str"/>
