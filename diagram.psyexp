      <Param name="Selected rows" updates="None" val="2" valType="str"/>
      <Param name="conditions" updates="None" val="[{'uuu': 0, 'eee': 'Ocenianie wielkości liczb\n\nPorównaj liczbę na boku z liczbą na środku. Jeśli liczba boczna jest większa naciśnij strzałkę do góry, jeśli jest mniesza naciśnij strzałkę w dół'}, {'uuu': 1, 'eee': 'Ocenianie kolejności w alfabecie\n\nPorównaj miejsce litery na boku z literą na środku. Jeśli litera na boku jest bliżej początku alfabetu naciśnij strzałkę w górę, jeśli jest bliżej końca naciśnij strzałkę w dół'}, {'uuu': 2, 'eee': 'Ocenianie wielkości wielkości figur\n\nPorównaj figurę na boku z figurą na środku. Jeśli figura boczna jest większa naciśnij strzałkę do góry, jeśli jest mniejsza naciśnij strzałkę w dół'}, {'uuu': 3, 'eee': 'Znowu liczby :) '}, {'uuu': 4, 'eee': 'Znowu litery :)'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="TestNaX/Teksty.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="t2" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="blabla"/>
    <LoopTerminator name="t2"/>
